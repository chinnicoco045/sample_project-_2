test("handleCancelConfirm navigates or calls handleNext based on byPassAddDupRecord", async () => {
  const mockNavigate = jest.fn();
  const mockHandleNext = jest.fn();

  jest.mock("react-router-dom", () => ({
    ...jest.requireActual("react-router-dom"),
    useNavigate: () => mockNavigate,
  }));

  const setOpenCancelDialogMock = jest.fn();
  const setalertMessageMock = jest.fn();
  const setbyPassAddDupRecordMock = jest.fn();

  const contextValue = {
    ...mockRowContextValues,
    selectedRow: [
      { id: "prod-1", productName: "Test Product" },
    ],
    handleNext: mockHandleNext,
    setOpenCancelDialog: setOpenCancelDialogMock,
    setalertMessage: setalertMessageMock,
    setbyPassAddDupRecord: setbyPassAddDupRecordMock,
  };

  // Mock validateForDuplicateRecords to return duplicate records
  const validateForDuplicateRecordsMock = jest.fn(() => ["Country1", "Country2", "Country3", "Country4", "Country5"]);
  jest.spyOn(service, "get").mockResolvedValue({
    data: {
      data: {
        content: [
          {
            applicationdata: JSON.stringify({
              productName: "Test Product",
              producerType: "Jordan Procedure",
              country: "Country1",
              formatType: "eCTD",
              region: "Asia",
              procedureType: "Jordan Procedure",
            }),
          },
          {
            applicationdata: JSON.stringify({
              productName: "Test Product",
              producerType: "Jordan Procedure",
              country: "Country2",
              formatType: "eCTD",
              region: "Asia",
              procedureType: "Jordan Procedure",
            }),
          },
          {
            applicationdata: JSON.stringify({
              productName: "Test Product",
              producerType: "Jordan Procedure",
              country: "Country3",
              formatType: "eCTD",
              region: "Asia",
              procedureType: "Jordan Procedure",
            }),
          },
          {
            applicationdata: JSON.stringify({
              productName: "Test Product",
              producerType: "Jordan Procedure",
              country: "Country4",
              formatType: "eCTD",
              region: "Asia",
              procedureType: "Jordan Procedure",
            }),
          },
          {
            applicationdata: JSON.stringify({
              productName: "Test Product",
              producerType: "Jordan Procedure",
              country: "Country5",
              formatType: "eCTD",
              region: "Asia",
              procedureType: "Jordan Procedure",
            }),
          },
        ],
      },
    },
  });

  // Mock form values to match the existing records
  (useForm as jest.Mock).mockReturnValue({
    register: jest.fn(),
    handleSubmit: jest.fn(),
    formState: { errors: {} },
    trigger: jest.fn(() => true),
    getValues: jest.fn(() => ({
      applicationId: "123",
      applicationNumber: "456",
      procedureNumber: "789",
      registrationId: "101112",
      productName: { label: "Test Product", value: "Test Product" },
      procedureType: { label: "Jordan Procedure", value: "Jordan Procedure" },
      formatType: "eCTD",
      region: "Asia",
      country: [
        { label: "Country1", value: "Country1" },
        { label: "Country2", value: "Country2" },
        { label: "Country3", value: "Country3" },
        { label: "Country4", value: "Country4" },
        { label: "Country5", value: "Country5" },
      ],
    })),
  });

  await act(async () => {
    renderComponent(contextValue);
  });

  // Simulate clicking the "cancel" button to open the dialog
  fireEvent.click(screen.getByText("cancel"));

  // Wait for the dialog to open
  await waitFor(() => {
    expect(screen.getByText("Confirm Cancel")).toBeInTheDocument();
  });

  // Simulate clicking the "Yes" button
  fireEvent.click(screen.getByRole("button", { name: /Yes/i }));

  await waitFor(() => {
    expect(setOpenCancelDialogMock).toHaveBeenCalledWith(false);
  });

  // Simulate clicking the "No" button
  fireEvent.click(screen.getByRole("button", { name: /No/i }));

  await waitFor(() => {
    expect(setOpenCancelDialogMock).toHaveBeenCalledWith(false);
  });
});
